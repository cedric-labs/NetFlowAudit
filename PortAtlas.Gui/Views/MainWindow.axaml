<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PortAtlas.Gui.Core.ViewModels"
        xmlns:catalog="using:PortAtlas.Gui.Core.Catalog"
        xmlns:views="using:PortAtlas.Gui.Views"
        xmlns:exec="using:PortAtlas.Gui.Core.Execution"
        x:Class="PortAtlas.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PortAtlas"
        Width="1100"
        Height="780"
        MinWidth="760"
        MinHeight="520">
  <Window.Resources>
    <ResourceDictionary>
      <views:OptionGroupIconConverter x:Key="GroupIcon" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />
          <SolidColorBrush x:Key="WarningBannerBrush" Color="#FFF4CE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF8A80" />
          <SolidColorBrush x:Key="WarningBannerBrush" Color="#4A3F10" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.group">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,2" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    </Style>
  </Window.Styles>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:FlagOptionViewModel">
      <StackPanel Margin="0,4" Spacing="2">
        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
        <TextBlock Classes="hint" Text="{Binding Description}" Margin="28,0,0,0" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:TextOptionViewModel">
      <StackPanel Margin="0,4" Spacing="2">
        <TextBlock Classes="label" Text="{Binding Name}" />
        <TextBlock Classes="hint" Text="{Binding Description}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding Value}" AutomationProperties.Name="{Binding Name}" />
          <Button Grid.Column="1" Command="{Binding BrowseCommand}" IsVisible="{Binding HasPathPicker}" Margin="6,0,0,0"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Folder}" /><TextBlock Text="Browse..." /></StackPanel></Button>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:IntegerOptionViewModel">
      <StackPanel Margin="0,4" Spacing="2">
        <TextBlock Classes="label" Text="{Binding Name}" />
        <TextBlock Classes="hint" Text="{Binding Description}" />
        <TextBox Text="{Binding Value}" AutomationProperties.Name="{Binding Name}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:ChoiceOptionViewModel">
      <StackPanel Margin="0,4" Spacing="2">
        <TextBlock Classes="label" Text="{Binding Name}" />
        <TextBlock Classes="hint" Text="{Binding Description}" />
        <Grid ColumnDefinitions="*,Auto">
          <ComboBox Grid.Column="0" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="catalog:ChoiceItem">
                <StackPanel Spacing="1" ToolTip.Tip="{Binding Description}">
                  <TextBlock Text="{Binding Value}" />
                  <TextBlock Classes="hint" Text="{Binding Description}" MaxWidth="420" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Command="{Binding ClearCommand}" Margin="6,0,0,0"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Close}" /><TextBlock Text="Clear" /></StackPanel></Button>
        </Grid>
        <TextBlock Classes="hint" Text="{Binding SelectedValueDescription}" IsVisible="{Binding SelectedValueDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:TextListOptionViewModel">
      <StackPanel Margin="0,4" Spacing="2">
        <TextBlock Classes="label" Text="{Binding Name}" />
        <TextBlock Classes="hint" Text="{Binding Description}" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBox Grid.Column="0" Text="{Binding PendingValue}" AutomationProperties.Name="{Binding Name}" />
          <Button Grid.Column="1" Command="{Binding AddItemCommand}" Margin="6,0,0,0"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Add}" /><TextBlock Text="Add" /></StackPanel></Button>
          <Button Grid.Column="2" Command="{Binding BrowseCommand}" IsVisible="{Binding HasPathPicker}" Margin="6,0,0,0"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.File}" /><TextBlock Text="File..." /></StackPanel></Button>
          <Button Grid.Column="3" Command="{Binding BrowseDirectoryCommand}" IsVisible="{Binding HasDirectoryPicker}" Margin="6,0,0,0"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Folder}" /><TextBlock Text="Folder..." /></StackPanel></Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding Values}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Command="{Binding $parent[ItemsControl].((vm:TextListOptionViewModel)DataContext).RemoveItemCommand}"
                        CommandParameter="{Binding}"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Close}" /><TextBlock Text="Remove" /></StackPanel></Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="12">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Classes="title" Text="PortAtlas" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="error" Text="{Binding Profiles.ErrorMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" />
      <TextBlock Grid.Column="2" Text="Profile" VerticalAlignment="Center" />
      <ComboBox Grid.Column="3" ItemsSource="{Binding Profiles.Names}" SelectedItem="{Binding Profiles.SelectedProfile}" Width="160" AutomationProperties.Name="Saved profiles" />
      <Button Grid.Column="4" Command="{Binding Profiles.LoadCommand}"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Load}" /><TextBlock Text="Load" /></StackPanel></Button>
      <TextBox Grid.Column="5" Text="{Binding Profiles.ProfileNameInput}" Watermark="Profile name" Width="150" AutomationProperties.Name="Profile name" />
      <Button Grid.Column="6" Command="{Binding Profiles.SaveCommand}"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Save}" /><TextBlock Text="Save" /></StackPanel></Button>
      <Button Grid.Column="7" Command="{Binding CycleThemeCommand}" AutomationProperties.Name="Switch colour theme"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Theme}" /><TextBlock Text="{Binding ThemeLabel}" /></StackPanel></Button>
    </Grid>

    <Border Grid.Row="1" Classes="card" IsVisible="{Binding !Executable.IsAvailable}" Background="{DynamicResource WarningBannerBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Binding Executable.StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Command="{Binding Executable.BrowseCommand}"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Folder}" /><TextBlock Text="Select PortAtlas..." /></StackPanel></Button>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="220,*" ColumnSpacing="12">
      <Border Grid.Column="0" Classes="card" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="label" Text="Commands" Margin="4,0,0,6" />
          <ListBox x:Name="CommandsList"
                   ItemsSource="{Binding Commands}"
                   SelectedItem="{Binding SelectedCommand}"
                   AutomationProperties.Name="Commands">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="catalog:CommandDescriptor">
                <TextBlock Text="{Binding Key}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto,200" RowSpacing="12">
        <Border Grid.Row="0" Classes="card">
          <ScrollViewer>
            <StackPanel DataContext="{Binding CurrentForm}" Spacing="6" Margin="0,0,12,0">
              <TextBlock Text="{Binding Command.Description}" TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding Arguments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PositionalArgumentViewModel">
                    <StackPanel Margin="0,4" Spacing="2">
                      <TextBlock Classes="label" Text="{Binding Name}" />
                      <TextBlock Classes="hint" Text="{Binding Description}" />
                      <TextBox Text="{Binding Value}" AutomationProperties.Name="{Binding Name}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionGroupViewModel">
                    <Expander Classes="group" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,6,0,0">
                      <Expander.Header><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{Binding Group, Converter={StaticResource GroupIcon}}" /><TextBlock Text="{Binding Group}" /></StackPanel></Expander.Header>
                      <ItemsControl ItemsSource="{Binding Options}" />
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="label" Text="Executable" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="mono hint" Text="{Binding Executable.StatusText}" ToolTip.Tip="{Binding Executable.StatusText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="2" Command="{Binding Executable.BrowseCommand}"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Folder}" /><TextBlock Text="Change..." /></StackPanel></Button>
              <Button Grid.Column="3" Command="{Binding Executable.ClearCommand}" IsVisible="{Binding Executable.ConfiguredPath, Converter={x:Static ObjectConverters.IsNotNull}}"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Refresh}" /><TextBlock Text="Automatic" /></StackPanel></Button>
            </Grid>
            <TextBlock Classes="label" Text="Command line" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="PreviewBox" Grid.Column="0" Classes="mono" Text="{Binding CurrentForm.Preview}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Command line preview" />
              <Button x:Name="CopyButton" Grid.Column="1" VerticalAlignment="Top" Click="OnCopyClick"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Copy}" /><TextBlock Text="Copy" /></StackPanel></Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding Run.RunCommand}" Classes="accent"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Play}" /><TextBlock Text="Run" /></StackPanel></Button>
              <Button Command="{Binding Run.CancelCommand}"><StackPanel Classes="iconButton"><PathIcon Classes="icon" Data="{StaticResource Icon.Stop}" /><TextBlock Text="Cancel" /></StackPanel></Button>
              <TextBlock Text="{Binding Run.State}" VerticalAlignment="Center" Margin="8,0,0,0" />
              <TextBlock Text="{Binding Run.ExitCode, StringFormat='Exit code: {0}'}" IsVisible="{Binding Run.ExitCode, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
              <TextBlock Classes="error" Text="{Binding Run.StatusMessage}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="4">
          <ListBox ItemsSource="{Binding Run.OutputLines}" AutomationProperties.Name="Command output">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="exec:RunOutputLine">
                <TextBlock Classes="mono" Classes.error="{Binding IsError}" Text="{Binding Text}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
