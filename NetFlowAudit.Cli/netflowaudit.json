{
  "ScanIntervalSeconds": 5,
  "OutputCsvPath": "netflow_audit.csv",
  "OutputNdjsonPath": "",
  "OutputHtmlMapPath": "",
  "OutputDrawioPath": "",
  "DrawioEdgeMode": "adaptive",
  "DrawioTheme": "dark",
  "MapExcludeEphemeralPorts": true,
  "MapListenersOnly": false,
  "MapDirection": "all",
  "MapIncludedPorts": [],
  "MapExcludedPorts": [],
  "MapIncludedHosts": [],
  "MapExcludedHosts": [],
  "MapIncludedIps": [],
  "MapExcludedIps": [],
  "MapIncludedProcesses": [],
  "MapExcludedProcesses": [],
  "MapLayoutMode": "layered",
  "MapSortMethod": "barycentric",
  "MapRoutingMode": "bezier",
  "MapSpacingProfile": "balanced",
  "CsvColumns": [
    "FirstSeenUtc",
    "LastSeenUtc",
    "ObservationCount",
    "ServerName",
    "ServerOsVersion",
    "ServerPrimaryIp",
    "Protocol",
    "Direction",
    "TcpState",
    "LocalIp",
    "LocalPort",
    "RemoteIp",
    "RemotePort",
    "RemoteHostName",
    "ProcessId",
    "ProcessName",
    "ExecutablePath",
    "CommandLine",
    "TargetExecutable",
    "UserName"
  ],
  "CsvDelimiter": ",",
  "ResolveRemoteHostNames": true,
  "ResolveIpOwners": true,
  "DnsCacheFilePath": "netflow_dns_cache.json",
  "DnsExcludedNetworks": [
    "0.0.0.0",
    "255.255.255.255",
    "169.254.0.0/16",
    "224.0.0.0/4",
    "fe80::/10",
    "ff00::/8"
  ],
  "ExcludedPids": [
    0,
    4
  ],
  "ExcludedExactNames": [
    "System",
    "Idle"
  ],
  "ExcludedPrefixes": [],
  "ExcludedSuffixes": [],
  "ExcludedContains": [],
  "ExcludeSystemAccounts": true,
  "ExcludeLoopbackFlows": true,
  "ExcludedLocalPorts": [],
  "ExcludedRemotePorts": [],
  "ExcludedRemoteIps": [],
  "EnableDashboard": true,
  "MaskServerName": "",
  "MaskLocalIp": "",
  "CustomHostAliases": {},
  "ReloadHistoryLimit": null
}